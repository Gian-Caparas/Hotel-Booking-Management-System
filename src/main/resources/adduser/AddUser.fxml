<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750" prefWidth="1200" style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.wildcat_hotel.adduser.AddUserController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220" spacing="4" style="-fx-background-color: #12122a; -fx-padding: 24 12 24 12;">

            <Label style="-fx-text-fill: #e2b96f; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 0 0 16 8;" text="🐱 WildCat Hotel" />

            <Label style="-fx-text-fill: #555577; -fx-font-size: 10; -fx-padding: 8 0 4 8;" text="OPERATIONS" />

            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openCheckIn" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Check-in Guest" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openCheckOut" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Check-out Guest" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openRoomBooking" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Book a Room" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openCancelBooking" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Cancel Booking" />

            <Label style="-fx-text-fill: #555577; -fx-font-size: 10; -fx-padding: 16 0 4 8;" text="RECORDS" />

            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openGuests" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  View Guests" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openRooms" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  View Rooms" />

            <Label style="-fx-text-fill: #555577; -fx-font-size: 10; -fx-padding: 16 0 4 8;" text="ADMIN" />

            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openAddUser" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Add User" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openDeleteUser" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  Delete User" />
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#openViewUsers" style="-fx-background-color: transparent; -fx-text-fill: #ccccee;                            -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 10 8;" text="  View Users" />

            <Region VBox.vgrow="ALWAYS" />

            <Label fx:id="currentUserLabel" style="-fx-text-fill: #555577; -fx-font-size: 11; -fx-padding: 0 0 0 8;" text="Logged in as: ..." />
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #1e1e38; -fx-padding: 24;">
            <!-- Default welcome screen -->
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
                <Label style="-fx-text-fill: #e2b96f; -fx-font-size: 28; -fx-font-weight: bold;" text="Add New User" />
            

               
               <Label style="-fx-text-fill: #ffffff; -fx-font-size: 16;" text="Username" />
               <TextField maxWidth="-Infinity" prefHeight="26.0" promptText="Enter your full name" style="-fx-pref-width: 200;" />
               

               <Label style="-fx-text-fill: #ffffff; -fx-font-size: 16;" text="Password" />
               <TextField maxWidth="-Infinity" prefHeight="26.0" promptText="Enter your password" style="-fx-pref-width: 200;" />
            <!password to fix>
            
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10" style="-fx-padding: 20;">
               <children>
                  <RadioButton mnemonicParsing="false" text="Admin" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </RadioButton>

                  <RadioButton mnemonicParsing="false" style="-fx-padding: 24;" text="Staff" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </RadioButton>
               </children>
            </HBox>

            


            </VBox>
        </StackPane>
    </center>

</BorderPane>
