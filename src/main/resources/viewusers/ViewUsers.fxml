<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
    alignment="CENTER"
    prefHeight="600"
    prefWidth="900"
    spacing="15"
    style="-fx-background-color: #1e1e38;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hotel.wildcat_hotel.viewusers.ViewUsersController">

    <children>

        <!-- TITLE -->
        <Label
            text="WildCat Hotel: View Users"
            style="-fx-text-fill: #f5c16c; -fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- SEARCH BAR -->
        <HBox
            alignment="CENTER_LEFT"
            spacing="15"
            prefWidth="749"
            prefHeight="38"
            maxWidth="749">

            <children>

                <!-- SEARCH TEXTFIELD -->
                <TextField
                    fx:id="txtSearch"
                    promptText="Enter username..."
                    prefHeight="38"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #2a2a4a;
                           -fx-text-fill: white;
                           -fx-prompt-text-fill: #666688;
                           -fx-border-color: #4444aa;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 14;" />

                <!-- SEARCH BUTTON -->
                <Button
                    fx:id="btnSearch"
                    text="Search"
                    prefHeight="38"
                    prefWidth="120"
                    mnemonicParsing="false"
                    style="-fx-background-color: #e2b96f;
                           -fx-text-fill: #1a1a2e;
                           -fx-font-size: 14;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;">

                    <HBox.margin>
                        <Insets left="5"/>
                    </HBox.margin>

                </Button>

            </children>

        </HBox>

        <!-- TABLE -->
        <TableView
            fx:id="usersTable"
            prefHeight="350"
            prefWidth="750"
            style="-fx-background-color: #2a2a4a;
                   -fx-control-inner-background: #2a2a4a;
                   -fx-table-cell-border-color: transparent;
                   -fx-text-background-color: dark-gray;">

            <columns>

                <TableColumn
                    fx:id="userIdColumn"
                    text="User ID"
                    prefWidth="100" />

                <TableColumn
                    fx:id="usernameColumn"
                    text="Username"
                    prefWidth="120" />

                <TableColumn
                    fx:id="roleColumn"
                    text="Role"
                    prefWidth="100" />

                <TableColumn
                    fx:id="emailColumn"
                    text="Email"
                    prefWidth="150" />

                <TableColumn
                    fx:id="phoneColumn"
                    text="Phone #"
                    prefWidth="130" />

                <TableColumn
                    fx:id="statusColumn"
                    text="Status"
                    prefWidth="100" />

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</VBox>