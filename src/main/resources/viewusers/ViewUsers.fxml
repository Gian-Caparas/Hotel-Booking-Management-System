<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="900.0" spacing="15" 
      style="-fx-background-color: #1e1e38;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.wildcat_hotel.viewusers.ViewUsersController">

    <!-- TITLE -->
    <Label style="-fx-text-fill: #f5c16c; -fx-font-size: 24px; -fx-font-weight: bold;" text="WildCat Hotel: View Users" />

    <!-- SEARCH BAR -->
    <HBox alignment="CENTER_LEFT" maxWidth="749.0" prefHeight="38.0" prefWidth="749.0" spacing="15">

            <children>


                <!-- SEARCH TEXTFIELD -->
                <TextField fx:id="txtSearch" prefHeight="38" promptText="Enter username..." style="-fx-background-color: #2a2a4a;                                   -fx-text-fill: white;                                   -fx-prompt-text-fill: #666688;                                   -fx-border-color: #4444aa;                                   -fx-border-radius: 6;                                   -fx-background-radius: 6;                                   -fx-font-size: 14;" HBox.hgrow="ALWAYS" />

                <!-- SEARCH BUTTON -->
                <Button fx:id="btnSearch" mnemonicParsing="false" prefHeight="38" prefWidth="120" style="-fx-background-color: #e2b96f;                                -fx-text-fill: #1a1a2e;                                -fx-font-size: 14;                                -fx-font-weight: bold;                                -fx-background-radius: 8;                                -fx-cursor: hand;" text="Search">

                    <HBox.margin>
                        <Insets left="5" />
                    </HBox.margin>

                </Button>

            </children>

    </HBox>


    <!-- TABLE -->
    <TableView fx:id="usersTable" maxWidth="-Infinity" prefHeight="350.0" prefWidth="750.0"
                    style="-fx-background-color: #2a2a4a;                          
                           -fx-control-inner-background: #2a2a4a;                           
                           -fx-table-cell-border-color: transparent;                           
                           -fx-text-background-color: dark-gray;">
        <columns>
            <TableColumn fx:id="userIdColumn" prefWidth="100.0" text="User ID" />
            <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Username" />
            <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" />
            <TableColumn fx:id="emailColumn" prefWidth="150.0" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="130.0" text="Phone #" />
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>