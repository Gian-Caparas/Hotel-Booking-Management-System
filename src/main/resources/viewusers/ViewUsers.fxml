<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" 
      prefHeight="600" 
      prefWidth="900.0" 
      spacing="15" 
      style="-fx-background-color: #1e1e38;" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.wildcat_hotel.viewusers.ViewUsersController">

    <children>

        <Label text="WildCat Hotel: View Users"
               style="-fx-text-fill: #f5c16c; -fx-font-size: 24; -fx-font-weight: bold;" />

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              prefWidth="749"
              prefHeight="38"
              maxWidth="749">

            <children>
                <TextField fx:id="usernamefield" 
                           prefHeight="38" 
                           promptText="Enter username..." 
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-prompt-text-fill: #666688; -fx-border-color: #4444aa; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14;" />

                <Button fx:id="searchButton" 
                        mnemonicParsing="false" 
                        onAction="#handleSearchUser" 
                        prefHeight="38" 
                        prefWidth="120" 
                        text="Search"
                        style="-fx-background-color: #e2b96f; -fx-text-fill: #1a1a2e; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
                    <HBox.margin>
                        <Insets left="5"/>
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="usersTable"
                   maxWidth="750"
                   prefHeight="350"
                   prefWidth="750"
                   style="-fx-background-color: #2a2a4a;
                          -fx-control-inner-background: #2a2a4a;
                          -fx-table-cell-border-color: transparent;
                          -fx-text-fill: white;">
            <columns>
                <TableColumn fx:id="userIdColumn" 
                             text="User ID" 
                             prefWidth="150" 
                             style="-fx-alignment: CENTER;
                                    -fx-text-fill: white;
                                    -fx-font-size: 13;" />
                <TableColumn fx:id="usernameColumn" 
                             text="Username" 
                             prefWidth="375"
                             style="-fx-alignment: CENTER;
                                    -fx-text-fill: white;
                                    -fx-font-size: 13;" />
                <TableColumn fx:id="roleColumn" 
                             text="Role" 
                             prefWidth="200" 
                             style="-fx-alignment: CENTER;
                                    -fx-text-fill: white;
                                    -fx-font-size: 13;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>