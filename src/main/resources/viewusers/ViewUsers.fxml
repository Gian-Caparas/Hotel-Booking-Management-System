<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="900.0" spacing="15" style="-fx-background-color: #1e1e38;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TITLE -->
    <Label style="-fx-text-fill: #f5c16c; -fx-font-size: 24px; -fx-font-weight: bold;" text="WildCat Hotel: View Users" />

    <!-- SEARCH BAR -->
    


    <HBox alignment="CENTER_LEFT"
              maxWidth="600"
              spacing="15">

            <children>

                <Label text="Search:"
                       textFill="WHITE">

                    <font>
                        <Font size="30"/>
                    </font>

                </Label>

                <!-- SEARCH TEXTFIELD -->
                <TextField fx:id="txtSearch"
                           promptText="Enter username..."
                           HBox.hgrow="ALWAYS"
                           prefHeight="38"
                           style="-fx-background-color: #2a2a4a;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #666688;
                                  -fx-border-color: #4444aa;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-background-radius: 10;
                                  -fx-font-size: 14;" />

                <!-- SEARCH BUTTON -->
                <Button fx:id="btnSearch"
                        mnemonicParsing="false"
                        onAction="#handleSearch"
                        text="Search"
                        prefWidth="120"
                        prefHeight="38"
                        style="-fx-background-color: #e2b96f;
                               -fx-text-fill: #1a1a2e;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;">

                    <HBox.margin>
                        <Insets left="5"/>
                    </HBox.margin>

                </Button>

            </children>

        </HBox>

    <!-- TABLE -->
    <TableView fx:id="usersTable" maxWidth="-Infinity" prefHeight="350.0" prefWidth="650.0">

        <columns>
            <TableColumn fx:id="userIdColumn" prefWidth="200.0" text="User ID" />
            <TableColumn fx:id="usernameColumn" prefWidth="200.0" text="Username" />
            <TableColumn fx:id="roleColumn" prefWidth="200.0" text="Role" />
            <TableColumn fx:id="emailColumn" prefWidth="200" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="200.0" text="Phone #" />
            <TableColumn fx:id="statusColumn" prefWidth="200.0" text="Status" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>

    </TableView>

</VBox>
