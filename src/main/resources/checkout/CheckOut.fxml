<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
    alignment="TOP_CENTER"
    prefHeight="700"
    prefWidth="960"
    spacing="25"
    style="-fx-background-color: #1e1e38; -fx-padding: 50px;"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.hotel.wildcat_hotel.checkout.CheckOutController">

    <children>

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="5">
            <children>
                <Label
                    text="Guest Check-Out"
                    style="-fx-text-fill: #e2b96f; -fx-font-size: 32; -fx-font-weight: bold;" />
                <Label
                    text="Search by Room ID to load reservation details"
                    style="-fx-text-fill: #888899; -fx-font-size: 14;" />
            </children>
        </VBox>

        <!-- SEARCH SECTION -->
        <HBox alignment="CENTER" spacing="15">
            <children>
                <VBox spacing="8">
                    <children>
                        <Label text="Room ID" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="roomSearchField"
                            promptText="e.g. 101"
                            prefHeight="40"
                            prefWidth="210"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                -fx-font-size: 13px;
                                   -fx-prompt-text-fill: #666688;
                                   -fx-border-color: #4444aa;
                                   -fx-border-radius: 6;
                                   -fx-background-radius: 6;"/>
                    </children>
                </VBox>
                <VBox spacing="8" alignment="BOTTOM_CENTER">
                    <children>
                        <Button
                            text="Search"
                            onAction="#handleSearch"
                            prefHeight="40"
                            prefWidth="110"
                            style="-fx-background-color: #e2b96f;
                                   -fx-text-fill: #1e1e38;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-background-radius: 6;"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Separator opacity="0.15" prefWidth="660"/>

        <!-- DETAILS GRID -->
        <GridPane alignment="CENTER" hgap="30" vgap="20">
            <columnConstraints>
                <ColumnConstraints prefWidth="300"/>
                <ColumnConstraints prefWidth="300"/>
            </columnConstraints>

            <children>
                <!-- Row 0: Guest Name (full) -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0">
                    <children>
                        <Label text="Guest Name" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="guestNameField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 1: Check-In Date -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Check-In Date" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="checkInField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 1: Check-Out Date -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Check-Out Date" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="checkOutField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 2: Room Type -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <children>
                        <Label text="Room Type" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="roomTypeField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 2: Room Capacity -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label text="Room Capacity" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="roomCapacityField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 3: Number of Days -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <children>
                        <Label text="Number of Days" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="numberOfDaysField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

                <!-- Row 3: Total Cost -->
                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <children>
                        <Label text="Total Cost" style="-fx-text-fill: #cccccc;" />
                        <TextField
                            fx:id="totalCostField"
                            editable="false"
                            prefHeight="40"
                            style="-fx-background-color: #2a2a4a;
                                   -fx-text-fill: white;
                                   -fx-opacity: 0.9;"/>
                    </children>
                </VBox>

            </children>
        </GridPane>

        <!-- FINAL ACTIONS -->
        <Region prefHeight="20"/>

        <VBox alignment="CENTER" spacing="15">
            <children>
                <Button
                    fx:id="checkOutButton"
                    text="Finalize Check-Out"
                    onAction="#handleCheckOut"
                    prefWidth="350"
                    prefHeight="50"
                    style="-fx-background-color: #e2b96f;
                           -fx-text-fill: #1e1e38;
                           -fx-font-weight: bold;
                           -fx-font-size: 16;
                           -fx-cursor: hand;
                           -fx-background-radius: 8;" />
            </children>
        </VBox>

    </children>
</VBox>
