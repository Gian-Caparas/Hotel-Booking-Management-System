<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.wildcat_hotel.login.LoginController"
      alignment="CENTER" spacing="18"
      prefWidth="480" prefHeight="420"
      style="-fx-background-color: #1a1a2e; -fx-padding: 60 60 60 60;">

    <!-- Title -->
    <Label text="🐱 WildCats Hotel"
           style="-fx-text-fill: #e2b96f; -fx-font-size: 26; -fx-font-weight: bold;"/>

    <Label text="Reservation System"
           style="-fx-text-fill: #aaaacc; -fx-font-size: 14;"/>

    <Region prefHeight="10"/>

    <!-- Username -->
    <VBox spacing="4">
        <Label text="Username"
               style="-fx-text-fill: #cccccc; -fx-font-size: 12;"/>
        <TextField fx:id="usernameField"
                   promptText="Enter username"
                   style="-fx-background-color: #2a2a4a; -fx-text-fill: white;
                          -fx-prompt-text-fill: #666688; -fx-border-color: #4444aa;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 10; -fx-font-size: 14;"/>
    </VBox>

    <!-- Password -->
    <VBox spacing="4">
        <Label text="Password"
               style="-fx-text-fill: #cccccc; -fx-font-size: 12;"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter password"
                       style="-fx-background-color: #2a2a4a; -fx-text-fill: white;
                              -fx-prompt-text-fill: #666688; -fx-border-color: #4444aa;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 10; -fx-font-size: 14;"/>
    </VBox>

    <Region prefHeight="6"/>

    <!-- Login Button -->
    <Button text="Login"
            onAction="#loginAction"
            prefWidth="360" prefHeight="42"
            style="-fx-background-color: #e2b96f; -fx-text-fill: #1a1a2e;
                   -fx-font-size: 15; -fx-font-weight: bold;
                   -fx-background-radius: 8; -fx-cursor: hand;"/>

</VBox>
