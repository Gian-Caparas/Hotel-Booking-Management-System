<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="500.0" 
            style="-fx-background-color: #001219;" 
            xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="CENTER" layoutX="50.0" layoutY="40.0" spacing="20.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">
         <children>
            <Text fill="#90E0EF" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 22; -fx-font-weight: bold;" text="Confirm Booking Details" />
            
            <GridPane hgap="15.0" style="-fx-background-color: #002129; -fx-background-radius: 10; -fx-padding: 20;" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Passport:" textFill="#CAF0F8" />
                  <Label fx:id="lblPassport" text="---" textFill="WHITE" GridPane.columnIndex="1" />
                  
                  <Label text="Guest Name:" textFill="#CAF0F8" GridPane.rowIndex="1" />
                  <Label fx:id="lblName" text="---" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Room Number:" textFill="#CAF0F8" GridPane.rowIndex="2" />
                  <Label fx:id="lblRoom" text="---" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Total Fees:" textFill="#CAF0F8" GridPane.rowIndex="3" />
                  <Label fx:id="lblFees" text="Php 0.00" textFill="#90E0EF" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>

            <HBox alignment="CENTER" spacing="25.0">
               <children>
                  <Button mnemonicParsing="false" prefWidth="120.0" style="-fx-background-color: #660000; -fx-text-fill: white;" text="Cancel" />
                  <Button mnemonicParsing="false" prefWidth="120.0" style="-fx-background-color: #00B4D8; -fx-text-fill: #001219; -fx-font-weight: bold;" text="Finalize Booking" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>