<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="700" prefWidth="960" spacing="16"
      style="-fx-background-color: #1e1e38; -fx-padding: 60;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.wildcat_hotel.deleteuser.DeleteUserController">

    <children>

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="5">
            <children>
                <Label style="-fx-text-fill: #e2b96f; -fx-font-size: 28; -fx-font-weight: bold;"
                       text="Delete User" />
                <Label style="-fx-text-fill: #888899; -fx-font-size: 13;"
                       text="Search and remove staff accounts" />
            </children>
        </VBox>

        <!-- SEARCH BAR -->
        <HBox alignment="CENTER_LEFT" maxWidth="749" prefHeight="38" prefWidth="749" spacing="15">
            <children>
                <TextField fx:id="usernamefield" prefHeight="38"
                           promptText="Enter username..."
                           style="-fx-background-color: #2a2a4a;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #666688;
                                  -fx-border-color: #4444aa;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-font-size: 14;"
                           HBox.hgrow="ALWAYS" />

                <Button fx:id="searchButton" mnemonicParsing="false"
                        onAction="#handleSearchUser"
                        prefHeight="38" prefWidth="120"
                        style="-fx-background-color: #e2b96f;
                               -fx-text-fill: #1a1a2e;
                               -fx-font-size: 14;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"
                        text="Search" />
            </children>
        </HBox>

        <!-- TABLE VIEW -->
        <TableView fx:id="usersTable" 
                   maxWidth="750" 
                   prefHeight="350"   
                   prefWidth="750"
                   style="-fx-background-color: #2a2a4a;
                          -fx-control-inner-background: #2a2a4a;
                          -fx-table-cell-border-color: transparent;
                          -fx-text-fill: white;">
            <columns>
                <TableColumn fx:id="usernameColumn" 
                             prefWidth="375" 
                             text="Username"
                             style="-fx-alignment: CENTER;
                                    -fx-text-fill: white;
                                    -fx-font-size: 13;" />
                <TableColumn fx:id="roleColumn" 
                             prefWidth="375" 
                             text="Role"
                             style="-fx-alignment: CENTER;
                                    -fx-text-fill: white;
                                    -fx-font-size: 13;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- REMOVE BUTTON -->
        <Button fx:id="deleteuser" mnemonicParsing="false"
                onAction="#handleDeleteUser"
                prefHeight="42" prefWidth="200"
                style="-fx-background-color: #ff4d4d;
                       -fx-text-fill: white;
                       -fx-font-size: 15;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"
                text="Remove" />

    </children>
</VBox>
