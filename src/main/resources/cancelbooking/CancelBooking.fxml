<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" 
      prefHeight="700" 
      prefWidth="960" 
      spacing="25" 
      style="-fx-background-color: #1e1e38; -fx-padding: 50px;" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.wildcat_hotel.cancelbooking.CancelBookingController">

    <children>

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="5">
            <children>
                <Label text="Cancel Booking" 
                       style="-fx-text-fill: #e2b96f; 
                       -fx-font-size: 32; -fx-font-weight: bold;" />
                <Label text="Review details before confirming cancellation" 
                       style="-fx-text-fill: #888899; -fx-font-size: 14;" />
            </children>
        </VBox>

        <!-- FORM GRID -->
        <GridPane alignment="CENTER" hgap="30" vgap="20">
            <columnConstraints>
                <ColumnConstraints prefWidth="320"/>
                <ColumnConstraints prefWidth="320"/>
            </columnConstraints>

            <children>
                <!-- ROW 1: Customer Details (First Name and Last Name) -->
                <VBox spacing="8" 
                      GridPane.columnIndex="0" 
                      GridPane.rowIndex="0">
                    <children>
                        <Label text="First Name" 
                               style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="firstNameField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <VBox spacing="8" 
                      GridPane.columnIndex="1" 
                      GridPane.rowIndex="0">
                    <children>
                        <Label text="Last Name" 
                               style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="lastNameField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <!-- ROW 2: Room Details (Room Type and Room Capacity) -->
                <VBox spacing="8" 
                      GridPane.columnIndex="0" 
                      GridPane.rowIndex="1">
                    <children>
                        <Label text="Room Type" 
                               style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="roomTypeField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                 -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <VBox spacing="8" 
                      GridPane.columnIndex="1" 
                      GridPane.rowIndex="1">
                    <children>
                        <Label text="Room Capacity" style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="roomCapacityField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <!-- ROW 3: Check-In and Check-Out -->
                <VBox spacing="8" 
                      GridPane.columnIndex="0" 
                      GridPane.rowIndex="2">
                    <children>
                        <Label text="Check-In Date" style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="checkInField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Label text="Check-Out Date" style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="checkOutField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <!-- ROW 4: Total Cost and Number of Days -->
                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <children>
                        <Label text="Total Cost" style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="totalCostField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <children>
                        <Label text="Number of Days" style="-fx-text-fill: #cccccc;" />
                        <TextField fx:id="numDaysField" 
                                   editable="false" 
                                   prefHeight="40" 
                                   style="-fx-background-color: #2a2a4a; 
                                   -fx-text-fill: white;"/>
                    </children>
                </VBox>

            </children>
        </GridPane>

        <!-- BUTTON -->
        <Region prefHeight="20"/>

        <Button
            fx:id="confirmCancelButton"
            text="Confirm Cancel Booking"
            onAction="#handleCancelBooking"
            prefWidth="350"
            prefHeight="50"
            style="-fx-background-color: #ff4d4d;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-font-size: 16;
                   -fx-cursor: hand;
                   -fx-background-radius: 8;" />

    </children>

</VBox>